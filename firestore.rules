rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null &&
        (request.auth.token.admin == true || request.auth.token.email == "admin@smartnutri.com");
    }

    function isValidChatMessage() {
      return request.resource.data.keys().hasOnly([
          "role",
          "content",
          "suggestions",
          "isError",
          "timestamp"
        ]) &&
        request.resource.data.keys().hasAll(["role", "content", "isError", "timestamp"]) &&
        request.resource.data.role in ["user", "assistant"] &&
        request.resource.data.content is string &&
        request.resource.data.content.size() <= 4000 &&
        request.resource.data.isError is bool &&
        request.resource.data.timestamp == request.time &&
        (!request.resource.data.keys().hasAny(["suggestions"]) || request.resource.data.suggestions is list);
    }

    function isValidAiUsage(monthId) {
      return monthId.matches("^\\d{4}-\\d{2}$") &&
        request.resource.data.keys().hasOnly(["monthKey", "aiScanUsed", "aiScanLimit", "updatedAt"]) &&
        request.resource.data.keys().hasAll(["monthKey", "aiScanUsed", "aiScanLimit", "updatedAt"]) &&
        request.resource.data.monthKey == monthId &&
        request.resource.data.aiScanUsed is int &&
        request.resource.data.aiScanUsed >= 0 &&
        request.resource.data.aiScanLimit == 5 &&
        request.resource.data.aiScanUsed <= request.resource.data.aiScanLimit &&
        request.resource.data.updatedAt == request.time;
    }

    function isValidAiUsageSummary(summary) {
      return summary is map &&
        summary.keys().hasOnly(["monthKey", "aiScanUsed", "aiScanLimit", "updatedAt"]) &&
        summary.keys().hasAll(["monthKey", "aiScanUsed", "aiScanLimit", "updatedAt"]) &&
        summary.monthKey.matches("^\\d{4}-\\d{2}$") &&
        summary.aiScanUsed is int &&
        summary.aiScanUsed >= 0 &&
        summary.aiScanLimit == 5 &&
        summary.aiScanUsed <= summary.aiScanLimit &&
        summary.updatedAt == request.time;
    }

    match /profiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /goals/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
        request.resource.data.keys().hasOnly(["aiScanUsage"]) &&
        isValidAiUsageSummary(request.resource.data.aiScanUsage);
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["aiScanUsage"]) &&
        isValidAiUsageSummary(request.resource.data.aiScanUsage) &&
        (!resource.data.keys().hasAny(["aiScanUsage"]) ||
          request.resource.data.aiScanUsage.monthKey != resource.data.aiScanUsage.monthKey ||
          request.resource.data.aiScanUsage.aiScanUsed >= resource.data.aiScanUsage.aiScanUsed);

      match /meal_entries/{entryId} {
        allow read, write: if isOwner(userId);
      }

      match /daily_stats/{date} {
        allow read, write: if isOwner(userId);
      }

      match /weight_log/{date} {
        allow read, write: if isOwner(userId);
      }

      match /favorites/{foodId} {
        allow read, write: if isOwner(userId);
      }

      match /chat_history/{messageId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidChatMessage();
        allow update: if false;
        allow delete: if isOwner(userId);
      }

      match /usage/{monthId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidAiUsage(monthId);
        allow update: if isOwner(userId) &&
          isValidAiUsage(monthId) &&
          request.resource.data.aiScanUsed >= resource.data.aiScanUsed;
        allow delete: if false;
      }
    }

    match /foods/{foodId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /workouts/{workoutId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /admin_stats/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
