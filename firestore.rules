rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /goals/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      // Admin can list all users for dashboard
      allow read: if request.auth != null &&
        (request.auth.uid == userId || request.auth.token.admin == true || request.auth.token.email == "admin@smartnutri.com");

      match /meal_entries/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /daily_stats/{date} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /weight_log/{date} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /favorites/{foodId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /chat_history/{messageId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false; // Chỉ Cloud Function mới được ghi
      }

      match /usage/{monthId} {
        allow read: if request.auth != null &&
          (request.auth.uid == userId || request.auth.token.admin == true || request.auth.token.email == "admin@smartnutri.com");
        allow write: if false;
      }
    }

    match /foods/{foodId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.token.admin == true || request.auth.token.email == "admin@smartnutri.com");
    }

    match /workouts/{workoutId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.token.admin == true || request.auth.token.email == "admin@smartnutri.com");
    }

    // Aggregate stats for admin dashboard
    match /admin_stats/{docId} {
      allow read, write: if request.auth != null && (request.auth.token.admin == true || request.auth.token.email == "admin@smartnutri.com");
    }
  }
}
